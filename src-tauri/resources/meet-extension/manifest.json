{
  "manifest_version": 3,
  "name": "Felix Meetings",
  "version": "0.3.1",
  "description": "Tells Felix who is talking on Google Meet, Zoom and Teams calls in the browser, so meeting transcripts get the right names. Talks only to Felix on this Mac.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Felix Meetings",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://app.zoom.us/wc/*",
        "https://*.zoom.us/wc/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://app.zoom.us/wc/*",
    "https://*.zoom.us/wc/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://teams.cloud.microsoft/*"
  ]
}
